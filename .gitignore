# Hidden files/dirs — strict policy: keep them out
.*
!.gitignore
!.gitattributes

# Build artifacts
/target/
Cargo.lock

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Secrets
.gnode/
*.password
*.key
*.pem

# Logs
*.log
logs/

# Local config
config/local.yaml

# OS files
.DS_Store
Thumbs.db

# Test coverage
*.profraw
*.profdata
coverage/

# Internal session/handoff documents (not for public release)
CLAUDE.md
*.scn.md
# …except the permanent contract primer, which is tracked alongside CONTRACT.md
!CONTRACT.scn.md
SESSION_*.md
MISSION_*.md
AUDIT_*.md

# Phase-2 work-in-progress preserved on dev boxes (Commit 1.6.a untracked
# these from the repo per CM-D1.01 + CM-D1.02 but the operator retains them
# locally for ongoing Phase-2 feature work).
