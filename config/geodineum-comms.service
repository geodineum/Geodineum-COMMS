[Unit]
Description=Geodineum-COMMS Notification Daemon
After=network.target valkey-gnode.service gnode-daemon.service
Wants=valkey-gnode.service gnode-daemon.service
# These keys belong in [Unit] — modern systemd ignores them under
# [Service] ("Unknown key name"), so the restart rate-limit would
# never apply there. The window key is named StartLimitIntervalSec.
#
# NO permanent give-up (StartLimitIntervalSec=0). A rate limit here means
# a TRANSIENT boot-time condition kills notifications until a human
# notices: on 2026-07-24 the daemon lost a chdir race at boot
# (status=200/CHDIR), exhausted 5 retries in seconds, and stayed dead for
# 20 h — Telegram and every email silently gone, while the on-disk state
# it had failed on was correct minutes later. For a notification daemon,
# "keep trying" always beats "die quietly"; RestartSec bounds the loop to
# 4 attempts/min, and a genuinely broken COMMS is now visible as a red
# heartbeat tile rather than as silence.
StartLimitIntervalSec=0

[Service]
Type=simple
# Dedicated runtime identity — COMMS does not share the gnode user.
# Credential reads come via the geodineum-comms group
# (valkey_comms.password, smtp_comms.* at root:geodineum-comms 0640);
# bootstrap.env via supplementary geodineum-bootstrap membership.
User=geodineum-comms
Group=geodineum-comms
SupplementaryGroups=geodineum-bootstrap
WorkingDirectory=/opt/geodineum/Geodineum-COMMS

Environment="RUST_LOG=geodineum_comms=info"

# Load component-specific secrets (TELEGRAM_BOT_TOKEN, COMMS_ADMIN_IDS, etc.)
# File is created by the operator — not in the repo. Missing file is non-fatal:
# a deployment that sends email but not Telegram legitimately has none.
#
# The `-` keeps ABSENT non-fatal. It also used to keep UNREADABLE silent, which
# is what cost 20 hours on 2026-07-24: the file existed, a permission sweep had
# grouped it away from this service's user, systemd skipped it without a word,
# and the daemon came up healthy with no token. The preflight below runs as
# THIS unit's User= and refuses to start on exists-but-unreadable, so that
# case is now loud and repeated (Restart=always) instead of silent and once.
# Guarded so a host that has not yet received the helper still starts: a
# preflight that cannot run must not become the new silent outage.
ExecStartPre=/bin/bash -c 'if [ -x /usr/local/lib/geodineum/assert-env-readable.sh ]; then exec /usr/local/lib/geodineum/assert-env-readable.sh /etc/geodineum/components/geodineum-comms/geodineum-comms.env; else echo "env-preflight: helper not installed at /usr/local/lib/geodineum — env readability UNVERIFIED" >&2; fi'
EnvironmentFile=-/etc/geodineum/components/geodineum-comms/geodineum-comms.env

# No ExecStartPre chmod here — it could never work under
# ProtectSystem=strict (read-only /opt) and the installer's
# geodeploy_fix_binaries owns executable bits.
# No --api-port/--api-bind flags — the Admin API was removed; clap
# exits status=2 on an unknown argument.
ExecStart=/bin/bash -c 'exec /opt/geodineum/Geodineum-COMMS/target/release/geodineum-comms \
    --redis-auth "$(cat /etc/geodineum/credentials/valkey_comms.password)" \
    --log-level info \
    start'

# always, not on-failure: a clean-but-unintended exit must also come back.
Restart=always
RestartSec=15

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/opt/geodineum/Geodineum-COMMS/.gnode /opt/geodineum/Geodineum-COMMS/logs /var/lib/geodineum-comms

LimitNOFILE=65536
TasksMax=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=geodineum-comms

[Install]
WantedBy=multi-user.target
