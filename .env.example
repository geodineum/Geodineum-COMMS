# GSD-COMMS Environment Variables
# Copy to .env and customize

# ValKey Connection
VALKEY_HOST=127.0.0.1
VALKEY_PORT=47445
VALKEY_USER=gsd_comms
VALKEY_AUTH=

# DTAP Environment
ENVIRONMENT=production

# Logging
LOG_LEVEL=info
RUST_LOG=gsd_comms=info

# API Server
API_BIND=127.0.0.1
API_PORT=8080

# Node Identity (optional, defaults to hostname)
# NODE_ID=comms-node-1

# Encryption Key (for credential encryption)
# GSD_COMMS_ENCRYPTION_KEY=

# Worker Threads (0 = auto)
WORKERS=0
